PORT=3000

# ---- Meta (Messenger) ----
VERIFY_TOKEN=اكتب-اي-كلمة-سرية-هنا
APP_SECRET=App-Secret-من-اعدادات-التطبيق
APP_ID=App-ID-من-اعدادات-التطبيق

# ---- WhatsApp عن طريق WAHA ----
# الجروب والصفحات بتتحدد من الداشبورد (تبويب الإعدادات)، مش محتاج تكتبهم هنا
# waha = Docker/سيرفر ، baileys = تشغيل على تليفون أندرويد (Termux)
WA_DRIVER=baileys
WAHA_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=حط-مفتاح-طويل-عشوائي

# ---- (اختياري) Claude لقراءة الأرقام المكتوبة حروف ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---- الداشبورد ----
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=غيّر-الباسورد-ده

# ---- للنشر على السيرفر (docker compose) ----
DOMAIN=leads.example.com
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=باسورد-قوي
